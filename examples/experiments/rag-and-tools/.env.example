# Choose exactly one deployment block. Do not mix Standalone and O11y variables.

# Standalone
SPLUNK_AO_API_KEY=your-standalone-api-key
SPLUNK_AO_CONSOLE_URL=https://your-console.example.com
# SPLUNK_AO_API_URL=https://your-api.example.com

# O11y Cloud (comment out the Standalone block before using this block)
# SPLUNK_AO_REALM=us1
# SPLUNK_AO_O11Y_TOKEN=your-o11y-ingest-token
# SPLUNK_AO_O11Y_API_TOKEN=your-o11y-api-token

# Common settings
SPLUNK_AO_PROJECT=your-project-name
SPLUNK_AO_AGENT_STREAM=your-agent-stream-name
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
