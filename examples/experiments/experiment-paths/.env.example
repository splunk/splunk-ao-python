# Choose exactly one deployment block. Do not mix Standalone and O11y variables.

# Standalone
SPLUNK_AO_API_KEY=your-standalone-api-key
SPLUNK_AO_CONSOLE_URL=https://your-console.example.com
# SPLUNK_AO_API_URL=https://your-api.example.com

# O11y Cloud (comment out the Standalone block before using this block)
# SPLUNK_AO_REALM=us1
# Required by runner_function.py and local_metric.py because they emit telemetry.
# SPLUNK_AO_O11Y_TOKEN=your-o11y-ingest-token
# May be used for prompt-only CRUD, or as a dedicated CRUD token with the ingest token.
# SPLUNK_AO_O11Y_API_TOKEN=your-o11y-api-token

# Common settings
SPLUNK_AO_PROJECT=your-project-name

# Used only by runner_function.py
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Used only by prompt_template.py. This alias must have an integration in Splunk AO.
SPLUNK_AO_PROMPT_MODEL_ALIAS=GPT-4o
