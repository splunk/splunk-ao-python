# Splunk Agent Observability — copy this file to .env and fill in your values.
# For rc0 verification use the values from:
#   /Users/admehra/galileo-dev/e2e-testing/py-sdk-and-ui/.env.splunk-ao-rc0

SPLUNK_AO_API_KEY=your-splunk-ao-api-key
SPLUNK_AO_API_URL=https://agent-observability-api.rc0.signalfx.com  # rc0 endpoint
SPLUNK_AO_CONSOLE_URL=https://agent-observability.rc0.signalfx.com  # rc0 console
SPLUNK_AO_USE_DIRECT_API=true
SPLUNK_AO_PROJECT=langchain-http-demo
SPLUNK_AO_LOG_STREAM=conversation-root-test

# Azure OpenAI (as used in rc0 e2e tests)
OPENAI_API_KEY=your-azure-openai-key
OPENAI_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/v1/
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01
