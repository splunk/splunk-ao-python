# Splunk AO Configuration
# Get your API key from: https://app.galileo.ai/settings/api-keys
SPLUNK_AO_API_KEY=your_splunk_ao_api_key_here

# Splunk AO console URL (change if using a custom deployment)
TRACELOOP_BASE_URL="https://api.galileo.ai/otel"
TRACELOOP_HEADERS="Splunk-AO-API-Key=your_splunk_ao_api_key_here, project=traceloop, logstream=default, X-Use-Otel-New=true"
TRACELOOP_METRICS_ENABLED=false

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
