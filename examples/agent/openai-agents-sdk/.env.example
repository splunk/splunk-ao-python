# Copy this file to .env and fill in your own values. Never commit .env.

# --- Splunk AO (Splunk Observability Cloud) ---------------------------------
# Use ONE deployment style. Do not mix the two sets of variables.
SPLUNK_AO_REALM=your-realm                  # for example: us1
SPLUNK_AO_O11Y_TOKEN=your-o11y-token        # token that is allowed to send telemetry
SPLUNK_AO_PROJECT=your-splunk-ao-project-name
SPLUNK_AO_AGENT_STREAM=your-splunk-ao-agent-stream-name

# Standalone deployment instead of Splunk Observability Cloud:
# SPLUNK_AO_API_KEY=your-splunk-ao-api-key
# SPLUNK_AO_CONSOLE_URL=your-splunk-ao-console-url

# --- Model used by the agent (OpenAI or any OpenAI-compatible endpoint) -----
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1   # optional, for example a LiteLLM proxy
# OPENAI_MODEL=gpt-4o-mini                                      # default: gpt-4o-mini

# --- Instrumentation mode ---------------------------------------------------
# sdk  = SplunkAOTracingProcessor (default)
# otel = community OpenTelemetry instrumentation for the Agents SDK
# INSTRUMENTATION=sdk
