OTEL_SERVICE_NAME=portkey-otel-instrumentation
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4321
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY
OTEL_INSTRUMENTATION_GENAI_EMITTERS=span_metric_event

OTEL_RESOURCE_ATTRIBUTES=splunk_ao.project.name=<your-project>,splunk_ao.logstream.name=portkey-otel-instrumentation,deployment.environment=<your-env>

# Portkey cloud credentials
PORTKEY_API_KEY=<your-portkey-api-key>
PORTKEY_VIRTUAL_KEY=<your-virtual-key-slug>
OPENAI_MODEL=gpt-4.1-mini

SSL_CERT_FILE=/opt/homebrew/etc/openssl@3/cert.pem
