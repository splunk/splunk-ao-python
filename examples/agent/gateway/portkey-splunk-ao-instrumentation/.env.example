OTEL_SERVICE_NAME=portkey-splunk-ao-instrumentation
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4320

SPLUNK_AO_REALM=<your-realm>
SPLUNK_AO_O11Y_TOKEN=<your-o11y-token>
SPLUNK_AO_PROJECT=<your-project>
SPLUNK_AO_AGENT_STREAM=portkey-splunk-ao-instrumentation

OTEL_RESOURCE_ATTRIBUTES=splunk_ao.project.name=<your-project>,splunk_ao.logstream.name=portkey-splunk-ao-instrumentation,deployment.environment=<your-env>

# Portkey cloud credentials — virtual key slug embedded in model name for ChatOpenAI base_url approach
PORTKEY_API_KEY=<your-portkey-api-key>
OPENAI_MODEL=@<your-virtual-key-slug>/gpt-4.1-mini

SSL_CERT_FILE=/opt/homebrew/etc/openssl@3/cert.pem
