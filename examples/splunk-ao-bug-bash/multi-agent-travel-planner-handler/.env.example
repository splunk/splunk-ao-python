# AI service
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://your-azure-openai-endpoint/openai/v1
OPENAI_MODEL=gpt-5-nano

# Optional quality-noise controls. A probability of 0 keeps the demo output clean.
TRAVEL_POISON_PROB=0
# TRAVEL_POISON_TYPES=hallucination,bias,irrelevance,negative_sentiment,toxicity
# TRAVEL_POISON_MAX=2
# TRAVEL_POISON_SEED=42

# Select exactly one deployment block. Do not mix O11y and standalone variables.

# O11y Cloud
# SPLUNK_AO_REALM=us1
# SPLUNK_AO_SF_TOKEN=your-splunk-ingest-token

# Standalone Agent Observability
# SPLUNK_AO_API_KEY=your-agent-observability-api-key
# SPLUNK_AO_CONSOLE_URL=https://app.galileo.ai
# SPLUNK_AO_API_URL=https://api.galileo.ai

# Configure project and log-stream routing for both deployment modes.
SPLUNK_AO_PROJECT=your-project-name
SPLUNK_AO_LOG_STREAM=your-logstream-name

# To route by ID instead, comment out the two name variables above and use:
# SPLUNK_AO_PROJECT_ID=your-project-id
# SPLUNK_AO_LOG_STREAM_ID=your-log-stream-id
